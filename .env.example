# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here
GEMINI_API_KEY=your-gemini-key-here

# ── Models ────────────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db

# ── Documents ─────────────────────────────────────────────────────────────────
# Directory containing your .md, .txt, or .pdf knowledge base files
DOCS_PATH=./sample_docs

# ── RAG Settings ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4
SIMILARITY_THRESHOLD=0.65

# ── Conversation ──────────────────────────────────────────────────────────────
# Number of previous exchanges kept in context (each exchange = 2 messages)
MAX_HISTORY_TURNS=6
TEMPERATURE=0.1

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=false
